# Infinity Space: variáveis do servidor em produção (copiar para .env na VPS, nunca para o Git).
# Em desenvolvimento nada disto é necessário: `npm run dev` funciona sem login e sem Drive.

# --- Servidor ---
PORT=2567
HOST=0.0.0.0
# Endereço público do app (usado nos links de e-mail e no cookie seguro).
PUBLIC_URL=https://space.ai-infinity.io
# Pasta dos dados salvos (contas, mural, plantas, rankings, gravações). Incluir no backup.
DATA_DIR=/var/lib/infinity/data

# --- Login por convite (link mágico, sem senha) ---
AUTH_REQUIRED=true
# Quem administra (convida e remove pessoas), separado por vírgula.
ADMIN_EMAILS=
# Domínios que entram sem convite (opcional). Ex.: empresa.com.br
ALLOWED_DOMAINS=
SESSION_DAYS=30
# Superadmin com senha (login por e-mail e senha): recebe a senha abaixo no primeiro start, enquanto não tiver uma.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- E-mail dos convites e links de entrada ---
# Ou uma URL completa (smtps://usuario:senha@smtp.exemplo.com:465)...
SMTP_URL=
# ...ou as partes:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Infinity Space <space@ai-infinity.io>

# --- LiveKit (áudio, vídeo e tela) ---
LIVEKIT_PUBLIC_URL=wss://rtc.space.ai-infinity.io
# No docker-compose o LiveKit roda na rede do host; o compose já define este valor para o app.
LIVEKIT_INTERNAL_URL=ws://host.docker.internal:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM=infinity-space

# --- HTTPS (Caddy) ---
# E-mail para o Let's Encrypt emitir os certificados de rtc e turn.
ACME_EMAIL=

# --- Gravação de reuniões no Google Drive (docs/infra.md, seção 7) ---
GOOGLE_APPLICATION_CREDENTIALS=/etc/infinity/google.json
DRIVE_FOLDER_ID=
TZ_DISPLAY=America/Sao_Paulo
FFMPEG_PATH=/usr/bin/ffmpeg

# A chave da ElevenLabs NÃO entra aqui: fica só no .env.local de quem gera os sons (scripts/sfx.mjs).
