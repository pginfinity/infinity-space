{
  "name": "@infinity/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Servidor do mundo do Infinity Space: WebSocket + API HTTP.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/index.js",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/index.js --packages=external --alias:@infinity/world=../../packages/world/src/index.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@infinity/world": "*",
    "hono": "^4.13.18",
    "livekit-server-sdk": "^2.19.3",
    "msgpackr": "^2.1.4",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
